#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks-per-node={{CPUS}}
#SBATCH --mem={{MEM}}
#SBATCH --time={{TIME}}
#SBATCH --partition={{PARTITION}}
{{GRES_LINE}}
#SBATCH --job-name={{NAME}}
#SBATCH --output=%x-%j.out
set -euo pipefail

# High-throughput: ONE job runs the whole tasklist across the node's cores.
# {{SCRIPT}} is the tasklist file (one shell command per line), NOT a program.
# This is the polite alternative to spraying N sbatch submissions.
module load launcher
{{MODULES_EXTRA}}
module list

PROJ=$HOME/work/juno-projects/{{SLUG}}
# immutable per-payload code snapshot: a later push cannot change what THIS job runs
CODE_SRC=$PROJ/snapshots/{{PAYLOAD_DIGEST}}/code
RESULTS=$PROJ/results
mkdir -p "$RESULTS"

SCRATCH=$HOME/scratch/{{SLUG}}-$SLURM_JOB_ID
# NOTE: an EXIT trap cannot fire on node failure or a forced kill - juno.sh clean-scratch sweeps orphans.
cleanup() {
  if cp -R "$SCRATCH"/results/. "$RESULTS"/; then rm -rf "$SCRATCH"
  else
    echo "ERROR: copy-out failed - scratch preserved at $SCRATCH (45-day purge; recover promptly)" >&2
    exit 1          # make the job FAIL so wait/fetch never treat undelivered results as success
  fi
}
trap cleanup EXIT
mkdir -p "$SCRATCH"/results
cd "$SCRATCH"
cp -R "$CODE_SRC" ./code
[ -d "$PROJ"/data ] && cp -R "$PROJ"/data .

# replication capture (cowrite R3 requirement)
mkdir -p results/replication
{ module list 2>&1; hostname; wc -l < "$SCRATCH/{{SCRIPT}}"; } > results/replication/environment_juno_${SLURM_JOB_ID}.txt

export LAUNCHER_WORKDIR=$SCRATCH
export LAUNCHER_JOB_FILE="$SCRATCH/{{SCRIPT}}"
export LAUNCHER_PPN={{CPUS}}
export LAUNCHER_NHOSTS=1

echo "Starting launcher tasklist {{SCRIPT}} ..."
$LAUNCHER_DIR/paramrun
echo "All tasks completed."
